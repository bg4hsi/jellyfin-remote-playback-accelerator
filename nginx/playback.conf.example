# 示例用 8443，避免和监听 SSH 的 TCP 443 冲突。
server {
    listen 8443 ssl http2;
    server_name media.example.com;

    ssl_certificate     /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/privkey.pem;

    access_log /var/log/nginx/jellyfin-playback.access.log jellyfin_cache;

    # 即使分片命中 VPS 缓存，也先向 Jellyfin 验证本次请求的凭据，
    # 避免缓存层绕过源站鉴权。需要 ngx_http_auth_request_module。
    location = /__jellyfin_auth {
        internal;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Emby-Authorization $http_x_emby_authorization;
        proxy_set_header X-MediaBrowser-Token $http_x_mediabrowser_token;
        proxy_set_header X-Emby-Token $http_x_emby_token;
        proxy_set_header Cookie $http_cookie;
        proxy_pass http://jellyfin_home/Users/Me?api_key=$arg_api_key;
    }

    location ~ ^/videos/[0-9A-Fa-f-]+/hls[^/]*/main/[0-9]+\.(?:ts|m4s)$ {
        auth_request /__jellyfin_auth;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";

        proxy_cache jellyfin_media;
        proxy_cache_key "hls|$uri|$http_range";
        proxy_cache_lock on;
        proxy_cache_valid 200 206 24h;
        proxy_ignore_headers Set-Cookie;
        proxy_hide_header Set-Cookie;

        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://jellyfin_home;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://jellyfin_home;
    }
}
