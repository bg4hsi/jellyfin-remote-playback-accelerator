# 放在 http {} 上下文中。njs 模块需按发行版方式预先加载；
# load_module 指令属于 main 上下文，不要直接写进被 http {} include 的文件。

js_import jellyfin_prefetch from /etc/nginx/njs/jellyfin_prefetch.js;
js_shared_dict_zone zone=jellyfin_state:1M timeout=24h;
js_set $jellyfin_track jellyfin_prefetch.track;

proxy_cache_path /var/cache/nginx/jellyfin-edge-cache
    levels=1:2
    keys_zone=jellyfin_media:64m
    inactive=24h
    max_size=8g
    use_temp_path=off;

log_format jellyfin_cache '$remote_addr $request status=$status '
    'rt=$request_time cache=$upstream_cache_status segment=$jellyfin_track';

log_format jellyfin_prefetch_log '$remote_addr $request status=$status '
    'rt=$request_time cache=$upstream_cache_status';

upstream jellyfin_home {
    server 127.0.0.1:18096;
    keepalive 16;
}

upstream jellyfin_origin_helper {
    server 127.0.0.1:18097;
    keepalive 8;
}
