#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=9

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/bin/jellyfin-prefetch-watchdog.py \
        --config /etc/jellyfin-prefetch-watchdog.json
    procd_set_param respawn 3600 10 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
