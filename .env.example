# VPS worker
PLAYER_STATUS_URL=http://127.0.0.1:8098/__prefetch_status
ORIGIN_STATUS_URL=http://127.0.0.1:18097/status
PREFETCH_BASE_URL=http://127.0.0.1:8098
PREFETCH_WINDOW=300
PREFETCH_WORKERS=4
DRAIN_BATCH=32
CACHE_VERIFY_BATCH=8
CACHE_VERIFY_RETRIES=3
POLL_SECONDS=5
PLAYER_STALE_SECONDS=45
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# VPS pressure-aware cache cleaner
JELLYFIN_CACHE_DIR=/var/cache/nginx/jellyfin-edge-cache
JELLYFIN_STATUS_URL=http://127.0.0.1:8098/__prefetch_status
JELLYFIN_CACHE_TRIGGER_FREE_GIB=3
JELLYFIN_CACHE_MAX_TRACK_AGE_MS=60000

# Home origin helper
TRANSCODE_DIR=/var/lib/jellyfin/transcodes
ORIGIN_LISTEN_HOST=127.0.0.1
ORIGIN_LISTEN_PORT=18097
ACTIVE_SECONDS=15
SAFETY_SEGMENTS=2
ALLOWED_EXTENSIONS=ts
