[Unit]
Description=Jellyfin read-only prefetch origin helper
After=network.target

[Service]
Type=simple
User=jellyfin
Group=jellyfin
EnvironmentFile=/etc/jellyfin-edge-cache/origin.env
ExecStart=/usr/bin/python3 /opt/jellyfin-edge-cache/jellyfin_prefetch_origin.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/jellyfin/transcodes

[Install]
WantedBy=multi-user.target
